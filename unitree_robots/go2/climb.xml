<mujoco model="go2 climb terrain">
  <include file="go2.xml"/>

  <!--
    The Go2 starts at the origin, facing +X. Two straight rows share four
    difficulty centres at X=4.1 / 8.9 / 13.7 / 18.5 m:
      Y=0: 1.50 x 2.00 m platforms, 30 / 40 / 50 / 60 cm high.
      Y=-3: 0.40 x 0.60 m boxes, 15 / 25 / 35 / 45 cm high.
    Flat ground separates each obstacle. Cycle F7 to show dimensions.
  -->
  <statistic center="10.3 -1.5 0.35" extent="11.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.25 0.25 0.25" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-135" elevation="-24"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.20 0.25 0.30" rgb2="0.10 0.13 0.16" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.0"/>
    <material name="platform_30cm_material" rgba="0.55 0.55 0.55 1"/>
    <material name="platform_40cm_material" rgba="0.55 0.55 0.55 1"/>
    <material name="platform_50cm_material" rgba="0.55 0.55 0.55 1"/>
    <material name="platform_60cm_material" rgba="0.55 0.55 0.55 1"/>
    <material name="small_box_material" rgba="0.55 0.55 0.55 1"/>
  </asset>

  <worldbody>
    <light pos="10.3 -1.5 8" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>

    <geom name="platform_30cm" type="box"
          pos="4.1 0 0.15" size="0.75 1 0.15"
          material="platform_30cm_material"/>
    <geom name="platform_40cm" type="box"
          pos="8.9 0 0.20" size="0.75 1 0.20"
          material="platform_40cm_material"/>
    <geom name="platform_50cm" type="box"
          pos="13.7 0 0.25" size="0.75 1 0.25"
          material="platform_50cm_material"/>
    <geom name="platform_60cm" type="box"
          pos="18.5 0 0.30" size="0.75 1 0.30"
          material="platform_60cm_material"/>
    <site name="Platform 30cm, 150x200cm top" pos="4.1 0 0.303" size="0.0005" group="2"/>
    <site name="Platform 40cm, 150x200cm top" pos="8.9 0 0.403" size="0.0005" group="2"/>
    <site name="Platform 50cm, 150x200cm top" pos="13.7 0 0.503" size="0.0005" group="2"/>
    <site name="Platform 60cm, 150x200cm top" pos="18.5 0 0.603" size="0.0005" group="2"/>
    <body name="climb_boxes_terrain" pos="0 -3 0">
      <include file="terrains/climb_boxes.xml"/>
    </body>
  </worldbody>
</mujoco>
